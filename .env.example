# ─── Server ──────────────────────────────────────────────────────────────────
DEBUG=true
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080
ENV_TYPE=LOCAL-DEV          # LOCAL-DEV | STAGING | PRODUCTION

# ─── Site ────────────────────────────────────────────────────────────────────
SITE_NAME=MyApp
SITE_DOMAIN=myapp.com
SITE_EMAIL=info@myapp.com
BASE_URL=http://localhost:3000
BASE_API_URL=http://localhost:8080

# ─── Database ────────────────────────────────────────────────────────────────
# Leave DBURL empty to use SQLite (development)
# Set DBURL to a postgres connection string for production
DBURL=
DBDRIVER=sqlite     # sqlite | postgres

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ISSUER=myapp

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
PRIMARY_EMAIL_HOST=smtp.gmail.com
PRIMARY_EMAIL_PORT=587
PRIMARY_EMAIL_USERNAME=you@gmail.com
PRIMARY_EMAIL_PASSWORD=your-app-password
PRIMARY_EMAIL_FROM=MyApp <you@gmail.com>
PRIMARY_EMAIL_REPLY_TO=you@gmail.com

# ─── Storage (Cloudinary) ─────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_FILE_PATH=./logs/app.log
ERROR_LOG_FILE_PATH=./logs/errors.log

# ─── Telegram Alerts (optional) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Master OTP (optional dev bypass — never set in production) ───────────────
MASTER_OTP=
